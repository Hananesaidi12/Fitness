  BarChart,
  Bar,
  XAxis,
  YAxis,
  Tooltip,
  ResponsiveContainer,
  Cell,
} from "recharts";

// === Sidebar ===
const Sidebar = ({ location }) => {
  const navItems = [
    { icon: FaHome, label: "Home", to: "/" },
    { icon: FaTachometerAlt, label: "Dashboard", to: "/dashbordLite" },
    { icon: FaDumbbell, label: "Workouts", to: "/workouts" },
    { icon: FaAppleAlt, label: "Nutrition", to: "/nutrition" },
    { icon: FaChartLine, label: "Progress", to: "/progress" },
    { icon: FaUsers, label: "Community", to: "/community" },
    { icon: FaCog, label: "Settings", to: "/settings" },
    { icon: FaSignOutAlt, label: "Logout", to: "/logout" },
  ];

  return (
    <aside style={styles.sidebar}>
      <div style={styles.logo}>
        Core<span style={{ color: "#FF6F3C" }}>Flex</span>
      </div>
      <nav style={styles.nav}>
        {navItems.map(({ icon: Icon, label, to }) => {
          const isActive = location.pathname === to;
          return (
            <Link
              key={label}
              to={to}
              style={{
                ...styles.navLink,
                ...(isActive ? styles.navLinkActive : {}),
              }}
            >
              <Icon size={20} style={{ marginRight: 12 }} />
              {label}
            </Link>
          );
        })}
      </nav>
    </aside>
  );
};

// === Header ===
const Header = ({ userFullName }) => {
  const initials = userFullName
    ? userFullName
        .split(" ")
        .map((n) => n[0].toUpperCase())
        .join("")
    : "";
  return (
    <header style={styles.header}>
      <h2 style={{ margin: 0, color: "#FF6F3C" }}>
        Welcome back, {userFullName.split(" ")[0]}!
      </h2>
      <Link to="/profile" style={styles.profileBtn}>
        <div style={styles.avatarInitials}>{initials}</div> Profile
      </Link>
    </header>
  );
};

const formatDate = (dateStr) =>
  new Date(dateStr).toLocaleDateString("fr-FR", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });

// === Stat Card ===
const StatCard = ({ label, value }) => (
  <div style={styles.statCard}>
    <p style={styles.statValue}>{value}</p>
    <p style={styles.statLabel}>{label}</p>
  </div>
);

// === Dashboard Lite ===
const DashboardLite = () => {
  const location = useLocation();
  const navigate = useNavigate();

  const [userFullName, setUserFullName] = useState("Utilisateur");
  const [loading, setLoading] = useState(true);

  const [stats, setStats] = useState({
    workoutsDone: 0,
    caloriesBurned: 0,
    activeDays: 0,
    progressPercent: 0,
  });

  const [goals, setGoals] = useState([]);
  const [recentActivities, setRecentActivities] = useState([]);
  const [dailyCalories, setDailyCalories] = useState([]);
  const [macros, setMacros] = useState({ protein: 0, carbs: 0, fat: 0 });

  // 🔹 Nutrition plans
  const [savedPlans, setSavedPlans] = useState([]);
  const [activePlan, setActivePlan] = useState(null);

  useEffect(() => {
  // Récupérer le nom utilisateur
  const storedName = localStorage.getItem("user_fullname");
  if (storedName) setUserFullName(storedName);

  // Charger stats (API exemple)
  const fetchStats = async () => {
    try {
      const userId = localStorage.getItem("userId");
      if (!userId) return;
      const res = await axios.get(
        `http://localhost:8000/client/stats?user_id=${userId}`
      );
      const data = res.data || {};
      setStats({
        workoutsDone: data.workoutsDone ?? 0,
        caloriesBurned: data.caloriesBurned ?? 0,
        activeDays: data.activeDays ?? 0,
        progressPercent: data.progressPercent ?? 0,
      });
      setGoals(data.goals || []);
      setRecentActivities(data.recentActivities || []);
    } catch (err) {
      console.error("Erreur chargement stats client:", err);
    } finally {
      setLoading(false);
    }
  };
  fetchStats();

  // 🔹 Charger le dernier plan sauvegardé
  const storedPlans = JSON.parse(localStorage.getItem("savedPlans")) || [];
  if (storedPlans.length > 0) {
    const lastPlan = storedPlans[storedPlans.length - 1]; // prendre le dernier plan
    setSavedPlans(storedPlans);
    setActivePlan(lastPlan);

    // appliquer ses macros et calories directement au dashboard
    setDailyCalories([
      {
        date: new Date(),
        calories: Number(lastPlan.dailyCalories) || 0,
      },
    ]);
    setMacros({
      protein: Number(lastPlan.macros?.protein) || 0,
      carbs: Number(lastPlan.macros?.carbs) || 0,
      fat: Number(lastPlan.macros?.fat) || 0,
    });
  } else {
    // fallback : nutritionResults (ancien stockage)
    try {
      const nutritionData = JSON.parse(localStorage.getItem("nutritionResults"));
      if (nutritionData) {
        setDailyCalories([
          {
            date: new Date(),
            calories: Number(nutritionData.dailyCalories) || 0,
          },
        ]);
        setMacros({
          protein: Number(nutritionData.macros?.protein) || 0,
          carbs: Number(nutritionData.macros?.carbs) || 0,
          fat: Number(nutritionData.macros?.fat) || 0,
        });
      }
    } catch (err) {
      console.warn("Données nutritionnelles non disponibles ou corrompues");
    }
  }
}, []);


  const toggleGoal = (id) => {
    setGoals((prev) =>
      prev.map((g) => (g.id === id ? { ...g, done: !g.done } : g))
    );
  };

  // 🔹 Charger un plan sauvegardé
  const loadSavedPlan = (plan) => {
    setActivePlan(plan);
  };

  // 🔹 Supprimer un plan
  const deleteSavedPlan = (id) => {
    const updatedPlans = savedPlans.filter((p) => p.id !== id);
    setSavedPlans(updatedPlans);
    localStorage.setItem("savedPlans", JSON.stringify(updatedPlans));
    if (activePlan?.id === id) setActivePlan(null);
  };

  if (loading) return <p style={{ padding: 40 }}>Chargement...</p>;

  return (
    <div style={styles.page}>
      <Sidebar location={location} />
      <main style={styles.mainContent}>
        <Header userFullName={userFullName} />

        {/* === Stats Cards === */}
        <section style={styles.statsSection}>
          <StatCard
          
            label="Workouts Done"
            value={stats.workoutsDone > 0 ? stats.workoutsDone : "–"}
          />
          <StatCard
            label="Calories Burned"
            value={
              stats.caloriesBurned > 0
                ? `${stats.caloriesBurned} kcal`
                : "–"
            }
          />
          <StatCard
            label="Active Days"
            value={stats.activeDays > 0 ? stats.activeDays : "–"}
          />
          <StatCard
            label="Progress"
            value={
              stats.progressPercent > 0
                ? `${stats.progressPercent}%`
                : "–"
            }
          />
        </section>

        {/* === Nutrition Charts === */}
        <section style={styles.chartSection}>
          <div style={styles.card}>
            <h3 style={styles.title}>Répartition des Macros</h3>
            {macros ? (
              <ResponsiveContainer width="100%" height={200}>
                <BarChart
                  data={[
                    { name: "Protéines", value: macros.protein || 0 },
                    { name: "Glucides", value: macros.carbs || 0 },
                    { name: "Lipides", value: macros.fat || 0 },
                  ]}
                >
                  <XAxis dataKey="name" />
                  <YAxis />
                  <Tooltip />
                  <Bar dataKey="value">
                    <Cell fill="#8884d8" /> {/* Protéines */}
                    <Cell fill="#82ca9d" /> {/* Glucides */}
                    <Cell fill="#ffc658" /> {/* Lipides */}
                  </Bar>
                </BarChart>
              </ResponsiveContainer>
            ) : (
              <p>Aucune donnée nutritionnelle disponible</p>
            )}
          </div>

          <div style={styles.card}>
            <h3 style={styles.title}>Suivi Calories</h3>
            <ResponsiveContainer width="100%" height={200}>
              <BarChart data={dailyCalories}>
                <XAxis dataKey="date" tickFormatter={(d) => formatDate(d)} />
                <YAxis />
                <Tooltip />
                <Bar dataKey="calories" fill="#7db043ff" />
              </BarChart>
            </ResponsiveContainer>
          </div>
        </section>

        {/* Goals & Recent Activity */}
        <section style={styles.grid}>
          <div style={styles.card}>
            <h3 style={styles.title}>Personal Goals</h3>
            <ul>
              {goals.map(({ id, text, done }) => (
                <li key={id} style={{ marginBottom: 8 }}>
                  <input
                    type="checkbox"
                    checked={done}
                    onChange={() => toggleGoal(id)}
                  />
                  <span
                    style={{
                      textDecoration: done ? "line-through" : "none",
                      marginLeft: 8,
                    }}
                  >
                    {text}
                  </span>
                </li>
              ))}
            </ul>
          </div>
          <div style={styles.card}>
            <h3 style={styles.title}>Recent Activity</h3>
            <ul style={{ listStyle: "none", padding: 0 }}>
              {recentActivities.map(({ id, description, date }) => (
                <li
                  key={id}
                  style={{
                    marginBottom: 8,
                    padding: 8,
                    backgroundColor: "#FFF5EB",
                    borderRadius: 8,
                  }}
                >
                  <strong>{date}</strong> – {description}
                </li>
              ))}
            </ul>
          </div>
        </section>

        {/* === Nutrition & Program === */}
<section style={styles.cardSection}>
  <h3 style={styles.title}>Plan Nutritionnel</h3>

  {activePlan ? (
    <>
      {/* Tableau des repas */}
      <table style={styles.table}>
        <thead>
          <tr>
            <th>Repas</th>
            <th>Proposition</th>
            <th>Calories</th>
          </tr>
        </thead>
        <tbody>
          {activePlan.meals?.map((meal, index) => (
            <tr key={index}>
              <td>{meal.type}</td>
              <td>{meal.items}</td>
              <td>{meal.calories} kcal</td>
            </tr>
          ))}
        </tbody>
      </table>

      {/* Programme sportif dynamique */}
      {activePlan.program?.length > 0 && (
        <>
          <h3 style={{ ...styles.title, marginTop: 20 }}>Programme Sportif</h3>
          <ul style={{ paddingLeft: 20 }}>
            {activePlan.program.map((day, index) => (
              <li key={index}>
                Jour {index + 1} : {day.name} ({day.duration})
              </li>
            ))}
          </ul>
        </>
      )}
    </>
  ) : (
    <p style={{ textAlign: "center", color: "#7f8c8d" }}>
      Aucun plan actif sélectionné
    </p>
  )}

  {/* 🔹 Section des plans sauvegardés */}
  <h3 style={{ ...styles.title, marginTop: 20 }}>Plans sauvegardés</h3>
  {savedPlans.length > 0 ? (
    <table
      style={{
        ...styles.table,
        border: "1px solid #bdc3c7",
        borderCollapse: "collapse",
      }}
    >
      <thead>
        <tr style={{ background: "#ecf0f1" }}>
          <th style={styles.th}>Date</th>
          <th style={styles.th}>Objectif</th>
          <th style={styles.th}>Calories / jour</th>
          <th style={styles.th}>Actions</th>
        </tr>
      </thead>
      <tbody>
        {savedPlans.map((plan) => (
          <tr key={plan.id}>
            <td style={styles.td}>{plan.date}</td>
            <td style={styles.td}>
              <span style={styles.badge}>{plan.answers.goal}</span>
            </td>
            <td style={styles.td}>{plan.calories} kcal</td>
            <td style={styles.actionCell}>
              <span
                onClick={() => loadSavedPlan(plan)}
                style={{
                  ...styles.badgeAction,
                  background: "#3498db",
                }}
              >
                🔄
              </span>
              <span
                onClick={() => deleteSavedPlan(plan.id)}
                style={{
                  ...styles.badgeAction,
                  background: "#e74c3c",
                }}
              >
                🗑
              </span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  ) : (
    <p
      style={{
        textAlign: "center",
        marginTop: "20px",
        color: "#7f8c8d",
        fontStyle: "italic",
      }}
    >
      Aucun plan sauvegardé pour le moment...
    </p>
  )}
</section>

      </main>
    </div>
  );
};

